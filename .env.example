# Host + player role
HOST_USER_NAME=YofiAsi
# Required. Entering HOST_USER_NAME on the name page also asks for this PIN (6 to 64 characters).
HOST_PIN=change-me
HOST_STALE_SECONDS=30
PLAYER_STALE_SECONDS=20
# Optional. How many songs one guest may have waiting at once (queued, processing or ready).
# The host is exempt. Default 5.
# MAX_ACTIVE_ITEMS_PER_USER=5
# Signs the identity cookie. Required in production with at least 32 characters,
# for example the output of: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Comma separated list of browser origins allowed to call the API and Socket.IO with cookies.
# Leave unset in production when the web app and API share one origin behind the reverse proxy.
# * is refused in production. Outside production the default is http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN=https://yofikaraoke.asafshilo.com

# DOMAIN / TLS: configure only in the Dokploy UI for production, not in this file.

# Postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://karaoke:change-me@postgres:5432/karaoke

# Stem storage: minio (default, Docker) or fs (a local folder, used by party mode on Windows).
# STORAGE_DRIVER=minio
# Required with STORAGE_DRIVER=fs: the folder that holds instrumentals/ and vocals/.
# STORAGE_DIR=C:\Users\you\AppData\Local\yofi-karaoke\stems

# MinIO (only needed with STORAGE_DRIVER=minio)
MINIO_ROOT_USER=karaoke
MINIO_ROOT_PASSWORD=change-me-long
MINIO_BUCKET=karaoke

# Worker / GPU
AUDIO_SEP_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx
# openvino = Intel Arc (docker-compose.yml) — production stack
# cuda     = NVIDIA GPU (docker-compose.nvidia.yml) — dev/WSL alternative
# cpu      = fallback, no GPU
SEPARATOR_BACKEND=openvino
# Folder audio-separator downloads its model into (default /app/models, the images mount it).
# AUDIO_SEP_MODEL_DIR=/app/models
# Worker binaries and temp folder. Defaults: python3, yt-dlp, <system temp>/karaoke.
# PYTHON_BIN=python3
# YTDLP_BIN=yt-dlp
# WORKER_TMP_DIR=/tmp/karaoke
# Songs processed at once (1 to 16, default 4). Downloads and lyrics lookups overlap; all GPU work
# still runs one request at a time in one long lived Python process that keeps the models loaded.
# WORKER_CONCURRENCY=4
# Automatic timed lyrics from the vocals stem with faster-whisper: cuda (party mode) or none (default,
# the Docker images do not ship faster-whisper). Needs about 3.2 GB of models in WHISPER_MODEL_DIR
# (default AUDIO_SEP_MODEL_DIR) and adds 4 to 11 s per song that has no synced LRCLIB lyrics.
# TRANSCRIBE_BACKEND=none
# WHISPER_MODEL_DIR=/app/models
# TRANSCRIBE_TIMEOUT_MS=180000
# Japanese lyrics (any hiragana or katakana) are stored and shown as lower case Hepburn romaji, converted
# with pykakasi after timing. false keeps the Japanese script. Existing songs change on "Find lyrics again".
# LYRICS_ROMAJI_ENABLED=true
# JavaScript runtime yt-dlp uses for YouTube when deno is not installed, for example node. Read by
# the api and the worker; without one some videos (for example made for kids) are refused as unavailable.
# YTDLP_JS_RUNTIMES=node
# Intel Arc only — override if host uses non-default GIDs for render/video:
# RENDER_GID=109
# VIDEO_GID=44

# --- Web Docker build (NEXT_PUBLIC_* is inlined at `pnpm build` / image build time)
# In Dokploy, set these as build arguments for the web service if you override defaults.
NEXT_PUBLIC_API_URL=/api
# same-origin = Socket.IO uses the browser origin (requires reverse proxy to forward
#   /socket.io to the api service on the same host, e.g. yofikaraoke.asafshilo.com).
# For local `pnpm --filter web dev` use: http://127.0.0.1:4000
# For a dedicated public API URL use a full URL, e.g. wss://yofikaraoke.asafshilo.com
NEXT_PUBLIC_WS_URL=same-origin
# Next server-side rewrites target (Docker service name). Rewrites are fixed at build time,
# so this must be set when running `next build`.
API_INTERNAL_URL=http://api:4000
# true makes `next build` emit .next/standalone (the web Dockerfile sets it). Off by default
# because the standalone step needs symlink rights on Windows.
# NEXT_OUTPUT_STANDALONE=true
